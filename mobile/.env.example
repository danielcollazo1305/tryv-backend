# Copie para .env.local e preencha com o IP da sua maquina na rede Wi-Fi.
# NAO use localhost/127.0.0.1 — um celular fisico rodando o Expo Go nao
# consegue alcancar o "localhost" do computador, precisa do IP da rede local.
EXPO_PUBLIC_API_URL=http://192.168.0.100:8000

# Chave PUBLICA do SDK do RevenueCat para iOS (comeca com "appl_"; e a chave do app no painel do RevenueCat, nao a secreta).
# Sem ela o app abre normalmente, mas a tela de assinatura mostra "indisponivel". Valor so no .env.local e no EAS (nunca no repositorio).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
