{
  "expo": {
    "name": "Tryv",
    "slug": "tryv-mobile",
    "scheme": "tryv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielcollazo.tryvmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.danielcollazo.tryvmobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Tryv precisa acessar suas fotos para voce anexar uma foto da refeicao.",
          "cameraPermission": "O Tryv precisa acessar a camera para voce fotografar sua refeicao."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Tryv precisa acessar sua localizacao para rastrear a rota da sua corrida ou pedalada.",
          "locationAlwaysAndWhenInUsePermission": "Precisamos da sua localizacao em segundo plano para continuar registrando sua corrida mesmo com a tela bloqueada ou o app minimizado.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Tryv acessa seus dados do Apple Health (treinos, passos, distancia, frequencia cardiaca, calorias ativas e sono) para mostrar seu resumo de atividade e importar treinos automaticamente.",
          "background": false
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "O Tryv acessa seus contatos para encontrar amigos que ja usam o app. So os numeros de telefone sao usados, nunca enviados ou salvos alem da checagem de correspondencia."
        }
      ],
      "expo-video",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afb48441-558e-4a04-af8a-2d300ec8073d"
      }
    }
  }
}
