{
  "expo": {
    "name": "Tryv",
    "slug": "tryv-mobile",
    "scheme": "tryv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielcollazo.tryvmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Tryv precisa acessar suas fotos para voce anexar uma foto da refeicao.",
          "cameraPermission": "O Tryv precisa acessar a camera para voce fotografar sua refeicao."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Tryv precisa acessar sua localizacao para rastrear a rota da sua corrida ou pedalada."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Tryv acessa seus treinos do Apple Health para importar automaticamente atividades como natacao, corrida e ciclismo.",
          "background": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afb48441-558e-4a04-af8a-2d300ec8073d"
      }
    }
  }
}
