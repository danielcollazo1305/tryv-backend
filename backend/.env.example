# Copie este arquivo para ".env" e preencha com seus valores reais

# URL publica desta API (usada no success_url/cancel_url do Stripe Checkout) —
# em producao, a URL do servico no Railway
APP_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_app
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-longa
ANTHROPIC_API_KEY=
# Conta separada da OpenAI — so usada pelos insights de baixo risco
# (daily_insight, activity_insight); analise de foto e treino continuam no Claude
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID do plano Tryv Pro (R$49/mes) criado no dashboard do Stripe
STRIPE_PRO_PRICE_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tryv-media-2026
AWS_S3_REGION=sa-east-1
# Resend — recuperacao de senha por e-mail (ver app/services/email.py)
RESEND_API_KEY=
