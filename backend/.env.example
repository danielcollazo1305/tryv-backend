# Copie este arquivo para ".env" e preencha com seus valores reais

# URL publica desta API (usada no success_url/cancel_url do Stripe Checkout) —
# em producao, a URL do servico no Railway
APP_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_app
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria-longa
ANTHROPIC_API_KEY=
# Conta separada da OpenAI — so usada pelos insights de baixo risco
# (daily_insight, activity_insight); analise de foto e treino continuam no Claude
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID do plano Tryv Pro (R$ 22,90/mes) criado no dashboard do Stripe. O valor cobrado e o do Price:
# ao mudar o preco, crie um NOVO Price (recorrente, mensal, BRL) e atualize esta variavel (no Railway tambem);
# o texto exibido no app esta em mobile/constants/pricing.ts e o da landing em landing/index.html
STRIPE_PRO_PRICE_ID=
# RevenueCat (assinatura Pro por compra dentro do app). Segredo compartilhado do webhook: o mesmo valor vai no campo
# 'Authorization header' do webhook no painel do RevenueCat (apontando para POST /webhooks/revenuecat). Vazio = webhook desligado (503).
REVENUECAT_WEBHOOK_AUTH=
# Nome do entitlement que significa 'Tryv Pro' no RevenueCat (padrao: pro)
REVENUECAT_PRO_ENTITLEMENT=pro
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tryv-media-2026
AWS_S3_REGION=sa-east-1
# Resend — recuperacao de senha por e-mail (ver app/services/email.py)
RESEND_API_KEY=
